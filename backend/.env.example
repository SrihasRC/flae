# Database Connection
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fact_ledger

# LLM Providers (At least one key required for extraction & arbitration)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

GROQ_API_KEY=your_groq_api_key_here
ARBITRATION_MODEL=groq/openai/gpt-oss-120b

# ChromaDB Vector Store
CHROMA_MODE=persistent
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_PREFIX=fact_ledger
CHROMA_PERSISTENT_PATH=chroma_data
